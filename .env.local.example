# Copier en .env.local puis remplir. .env.local n'est jamais commité.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://hhqojsbdmiybqvxwddsx.supabase.co

# Serveur uniquement : contourne la RLS. Jamais de préfixe NEXT_PUBLIC_.
# Toutes les lectures/écritures passent par le serveur, donc la clé anon n'est
# pas nécessaire ici.
SUPABASE_SERVICE_ROLE_KEY=

# Code d'accès de l'administrateur. C'est le code d'amorçage : il reste
# utilisable même quand la table `techniciens` est vide, et c'est lui qui donne
# accès à /admin pour créer les codes des techniciens.
CODE_ADMIN=Masc+2025

# Signature du cookie de session ET des empreintes de codes d'accès.
# 32 caractères minimum. Générer avec : openssl rand -base64 36
# ⚠ Le changer invalide tous les codes techniciens déjà distribués.
SESSION_SECRET=

# Double authentification : après le code d'accès, un code à 6 chiffres est
# envoyé par e-mail. Les techniciens le reçoivent à l'adresse renseignée dans
# /admin ; l'administrateur d'amorçage à ADMIN_EMAIL.
ADMIN_EMAIL=

# Envoi des e-mails par SMTP : n'importe quel fournisseur convient (Office 365,
# Gmail / Google Workspace, Brevo, Resend, hébergeur). Sans ces variables, en
# développement, le code s'affiche dans la console au lieu d'être envoyé.
# Hostinger (comme campus-print) : smtp.hostinger.com, port 465, avec
# l'adresse complète de la boîte et son mot de passe. Ne pas utiliser
# smtp.titan.email, qui refuse l'authentification (erreur 535).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché. Vide, on reprend SMTP_USER.
SMTP_FROM=
